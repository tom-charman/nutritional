# Google Sheets Configuration
# To use Google Sheets as data source:
# 1. Create a Google Cloud project
# 2. Enable Google Sheets API and Google Drive API
# 3. Create a service account and download JSON credentials
# 4. Share your Google Sheet with the service account email
# 5. Copy the spreadsheet ID from the URL and set it below

GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_RANGE=Sheet1!A:Z
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json

# Local CSV Fallback
# If Google Sheets is not configured, the app will use this CSV file
LOCAL_CSV_PATH=local_data/Food - Daily.csv

# App Configuration
DASH_DEBUG=True
DASH_HOST=0.0.0.0
DASH_PORT=8050

# ============================================
# DATABASE CONFIGURATION (Phase 2)
# ============================================

# PostgreSQL Connection
# Primary connection URL (recommended)
# SECURITY: Replace YOUR_SECURE_PASSWORD with actual password!
# Generate secure password: openssl rand -base64 32
DATABASE_URL=postgresql://nutritional_user:YOUR_SECURE_PASSWORD@localhost:5432/nutritional_db

# Alternative: Individual connection parameters
# Uncomment and use these instead of DATABASE_URL if needed
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nutritional_db
# DB_USER=nutritional_user
# DB_PASSWORD=YOUR_SECURE_PASSWORD

# For production (Google Cloud, etc.):
# DATABASE_URL=postgresql://nutritional_user:YOUR_SECURE_PASSWORD@localhost:5432/nutritional_db
# NOTE: Use 'localhost' in production - app and DB should be on same server!

# Setup Instructions:
# 1. Local Docker: Run `docker-compose up -d` from project root (dev only)
# 2. Production Server: Run `sudo database/setup.sh` (prompts for secure password)
# 3. Copy generated password to .env file
# 4. Test: python -c "from nutritional.database.connection import test_connection; test_connection()"

# ============================================
# ARCHITECTURE NOTES
# ============================================
# Phase 2: PostgreSQL for data entry, Google Sheets for visualization
# - Food database, daily entries, history -> PostgreSQL
# - Charts and analytics -> Google Sheets (until Phase 3)

# Data directory for file-based storage
DATA_DIR=nutritional_data
