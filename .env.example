# Google Sheets Configuration
# To use Google Sheets as data source:
# 1. Create a Google Cloud project
# 2. Enable Google Sheets API and Google Drive API
# 3. Create a service account and download JSON credentials
# 4. Share your Google Sheet with the service account email
# 5. Copy the spreadsheet ID from the URL and set it below

GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_RANGE=Sheet1!A:Z
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json

# Local CSV Fallback
# If Google Sheets is not configured, the app will use this CSV file
LOCAL_CSV_PATH=local_data/Food - Daily.csv

# App Configuration
DASH_DEBUG=True
DASH_HOST=0.0.0.0
DASH_PORT=8050
