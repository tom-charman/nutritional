# Database
DATABASE_URL=postgresql://nutritional_user:dev_password@127.0.0.1:5432/nutritional_db

# Auth.js (Google sign-in)
# Generate AUTH_SECRET with: openssl rand -base64 33
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public URL of the app (behind nginx), e.g. https://your-domain.com
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Comma-separated sign-in allowlist
AUTHORIZED_EMAILS=you@example.com
