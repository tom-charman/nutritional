# Database
DATABASE_URL=postgresql://nutritional_user:dev_password@127.0.0.1:5432/nutritional_db

# Auth.js (Google sign-in)
# Generate AUTH_SECRET with: openssl rand -base64 33
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public URL of the app (behind nginx), e.g. https://your-domain.com
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Comma-separated sign-in allowlist
AUTHORIZED_EMAILS=you@example.com

# Where denied users' waitlist emails are appended (one per line).
# Defaults to ./local_data/waitlist.txt in dev. In production set an ABSOLUTE
# path OUTSIDE the rotated release dir (e.g. /home/<user>/apps/nutritional/waitlist.txt)
# or the file is wiped on the next deploy.
WAITLIST_PATH=
