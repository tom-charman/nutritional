# Database — same DB and URL the Python app used (schema unchanged)
DATABASE_URL=postgresql://nutritional_user:dev_password@127.0.0.1:5432/nutritional_db

# Auth.js (replaces OIDC_SECRET_KEY / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET)
# Generate with: openssl rand -base64 33
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public URL of the app (behind nginx), e.g. https://your-domain.com
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Comma-separated allowlist (replaces AUTHORIZED_USERS_FILE)
AUTHORIZED_EMAILS=you@example.com
