[run]
omit =
    */tests/*
    */old_tests/*
    */__pycache__/*
    */data_handling.py
    */plotting.py
    */layout.py
    .venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if False:
    if TYPE_CHECKING:
